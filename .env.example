# CoindeccFlow frontend configuration (public values only, never secrets)
# Chain the app runs on. 5042002 = Arc Testnet.
VITE_FLOW_CHAIN_ID=5042002
# Deployed CoindeccFlowEscrow address on that chain.
VITE_FLOW_ESCROW_ADDRESS=
# Block the escrow was deployed at (event scans start here).
VITE_FLOW_DEPLOY_BLOCK=

# WalletConnect v2 project id (public value). Create one free at https://cloud.reown.com and add
# every domain that serves the app to its allowed domains. Without it, QR / mobile-app connections
# are disabled; browser extensions and in-app wallet browsers still work.
VITE_WALLETCONNECT_PROJECT_ID=

# Deployment (used by `forge script`, shell environment only)
# USDC ERC-20 address on the target chain. Read it from src/onchain-facts.ts.
USDC_ADDRESS=
# RPC endpoint for the target chain. Read it from src/onchain-facts.ts.
RPC_URL=
