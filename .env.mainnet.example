# CoindeccFlow frontend settings for Arc Mainnet (public values only, never secrets).
# Verified deployment; use only for an isolated Mainnet frontend.
# Chain 5042 = Arc Mainnet (see src/onchain-facts.ts for the registry values).
VITE_FLOW_CHAIN_ID=5042
# Verified deployment transaction is recorded in docs/mainnet-deployment-receipt.json.
VITE_FLOW_ESCROW_ADDRESS=0x20fBfF6d3048A0583fB969cD74DB1501A9C9C043
# Block number of your mainnet deployment transaction receipt.
VITE_FLOW_DEPLOY_BLOCK=28846016

# Optional: activates the server-side Alchemy gateway on an isolated deployment.
VITE_ARC_MAINNET_RPC_PATH=/api/arc-mainnet
# SERVER ONLY. Set privately in the isolated hosting environment. Never prefix with VITE_.
ALCHEMY_ARC_MAINNET_API_KEY=
